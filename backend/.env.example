# Active FAQ data store backend ("json" for initial release, "postgres" once migrated)
FAQ_BACKEND=json

# Optional confidence threshold override for intent classification (defaults to model_metadata.json value: 0.25)
CONFIDENCE_THRESHOLD=0.25

# Prepared PostgreSQL connection URL (not required while FAQ_BACKEND=json)
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ai_student_chatbot

# Admin Authentication Settings (Required for Admin Dashboard access)
# Set your chosen administrator username:
ADMIN_USERNAME=your_admin_username_here

# Set either ADMIN_PASSWORD (min 12 chars) or a pre-computed ADMIN_PASSWORD_HASH:
ADMIN_PASSWORD=your_secure_strong_password_here
# Optional pre-computed salted PBKDF2 hash (preferred in production):
# ADMIN_PASSWORD_HASH=pbkdf2_sha256$100000$salt_hex$hash_hex

# Cryptographic secret key used to sign JWT access tokens:
# MUST be at least 32 characters (256 bits). Generate with: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_JWT_SECRET=your_32_plus_character_cryptographically_secure_random_jwt_secret_here



